# Copy to .env.local and fill in real values. Never commit .env.local.

# Enable only after shared database migration 026 has been verified.
AIRDROP_SCHEMA_READY=false
# Server-only credentials for private warehouse document retrieval. Never NEXT_PUBLIC.
AIRDROP_API_KEY=
AIRDROP_ORGANIZATION_ID=

# ── Database (PHP bridge) ───────────────────────────────────────────
# MySQL :3306 is firewalled; all DB access goes through the PHP bridge.
BRIDGE_URL=
BRIDGE_SECRET=
# Pre-alert receipt upload endpoint (route falls back to BRIDGE_URL if unset).
# Legacy name from the abandoned host-PHP upload (sp04 branch); unused on master.
PREALERT_UPLOAD_URL=

# ── Private file store (Vercel Blob "swiftbox-admin-blob", PRIVATE) ─
# Optional pre-alert invoices (src/lib/prealert-file-server.ts). Connected to
# the Vercel project in all three environments; never NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=

# ── Session ─────────────────────────────────────────────────────────
SESSION_SECRET=

# ── SMTP (cPanel mailbox — password-reset email) ────────────────────
# Visible From: is noreply@ but the envelope MAIL FROM is SMTP_USER (info@)
# so cPanel sender-verify passes. Port 465 = implicit TLS; 587 = STARTTLS.
SMTP_HOST=mail.swiftboxtt.com
SMTP_PORT=465
SMTP_USER=info@swiftboxtt.com
SMTP_PASS=
SMTP_FROM="Swift Box <noreply@swiftboxtt.com>"

# Base URL used to build password-reset links.
APP_URL=http://localhost:3005

# Website base URL (the marketing/signup site, NOT the app). Used to build the
# referral invite link: SIGNUP_URL/r/CODE (the website's invite page). Prod: https://swiftboxtt.com
#
# VALIDATED as of the share-link hardening: this is a same-site override, not an
# escape hatch. Only https://swiftboxtt.com and https://www.swiftboxtt.com are
# accepted. Anything else (blank, http, app.swiftboxtt.com, localhost, a typo)
# is ignored with a console.warn and the hardcoded https://swiftboxtt.com in
# src/lib/referral.ts is used instead, so a bad value here can no longer hand a
# referred friend a 404.
SIGNUP_URL=https://swiftboxtt.com

# ── Referral system ─────────────────────────────────────────────────
# Credit (TTD) awarded to the REFERRER when a referred customer qualifies (their
# first package is DELIVERED). The referred friend separately gets a TT$50 welcome
# credit (REFERRAL_WELCOME_CREDIT_TTD), created when their first invoice is issued.
# Single source of truth for later sub-pieces.
REFERRAL_CREDIT_TTD=100

# Consolidated Billing — the app's two server-to-server calls into the admin
# (turning the setting on/off; fetching a Consolidated Bill PDF). Must equal the
# admin's CONSOLIDATION_HOOK_KEY (24+ characters). Set in Production + Preview.
CONSOLIDATION_HOOK_KEY=
# Optional; defaults to https://admin.swiftboxtt.com
ADMIN_URL=
